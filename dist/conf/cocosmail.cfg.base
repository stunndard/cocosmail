# cocosmail configuration
#
# One setting per line: COCOSMAIL_KEY=value, without quotes. An empty value
# means the default. Relative paths are relative to the cocosmail binary
# directory. This file can be used as is as a docker env file.
#
# conf/cocosmail.cfg is imported into the database at the first start, then
# use cocosmail config. With --config FILE, FILE is loaded at every start.

# --- general ---

# Hostname of this server, used in HELO/EHLO and as default for outgoing mail
# (required)
COCOSMAIL_ME=cocosmail.io

# Hide cocosmail version in SMTP greeting (default: false)
COCOSMAIL_HIDE_SERVER_SIGNATURE=false

# Log debug messages (default: false)
COCOSMAIL_DEBUG_ENABLED=false

# Where to log: "stdout", "discard" or an existing directory (default: stdout)
COCOSMAIL_LOGPATH=stdout

# Temporary directory for scanning and filtering, a RAM disk like /dev/shm is
# recommended (default: /tmp)
COCOSMAIL_TEMPDIR=/dev/shm

# Directory of plugins (default: plugins)
COCOSMAIL_PLUGIN_PATH=plugins

# --- database ---

# Database driver: sqlite3, mysql or postgres (default: sqlite3)
COCOSMAIL_DB_DRIVER=sqlite3

# Database source. For sqlite3 the file, relative to the cocosmail binary
# directory. MySQL: user:passwd@tcp(ip:port)/cocosmail?parseTime=true,
# PostgreSQL: user=cocosmail dbname=cocosmail sslmode=disable (default:
# db/cocosmail.db?_busy_timeout=60000)
COCOSMAIL_DB_SOURCE=db/cocosmail.db?_busy_timeout=60000

# --- store ---

# Where messages waiting in queue are stored: disk (default: disk)
COCOSMAIL_STORE_DRIVER=disk

# Directory of the disk store (default: store)
COCOSMAIL_STORE_SOURCE=store

# --- cluster ---

# Run cocosmail as a cluster (default: false)
COCOSMAIL_CLUSTER_MODE_ENABLED=false

# nsqlookupd TCP addresses in cluster mode, IP:PORT separated by ;
COCOSMAIL_NSQ_LOOKUPD_TCP_ADDRESSES=127.0.0.1:4160

# nsqlookupd HTTP addresses in cluster mode, IP:PORT separated by ;
COCOSMAIL_NSQ_LOOKUPD_HTTP_ADDRESSES=127.0.0.1:4161

# --- smtpd ---

# Launch the SMTP server (default: false)
COCOSMAIL_SMTPD_LAUNCH=true

# SMTP listeners separated by ;, each IP:PORT:HOSTNAME:ssl|nossl:CERT. IPv6 in
# brackets: [2001:db8::1]. [::] or 0.0.0.0 listen on all IPv4 and IPv6
# addresses. ssl: TLS from the start (465), nossl: STARTTLS available (25,
# 587). Certificate: ssl/smtp-CERT.crt and .key (required)
COCOSMAIL_SMTPD_DSNS=0.0.0.0:2525:cocosmail.io:nossl:cocosmail.io

# Seconds before an idle SMTP client is disconnected (RFC 5321 4.5.3.2.7: 300)
# (default: 300)
COCOSMAIL_SMTPD_SERVER_TIMEOUT=60

# Maximum size of an incoming message in bytes, 0 is unlimited (default: 0)
COCOSMAIL_SMTPD_MAX_DATABYTES=50000000

# Maximum Received headers, to prevent loops (default: 10)
COCOSMAIL_SMTPD_MAX_HOPS=50

# Maximum RCPT TO per message, 0 is unlimited (RFC compliant) (default: 0)
COCOSMAIL_SMTPD_MAX_RCPT=0

# Drop the session after this many unknown recipients, 0 never drops (RFC
# compliant) (default: 0)
COCOSMAIL_SMTPD_MAX_BAD_RCPT=0

# Maximum VRFY commands per session, 0 is unlimited (default: 0)
COCOSMAIL_SMTPD_MAX_VRFY=0

# Maximum simultaneous incoming SMTP sessions (default: 20)
COCOSMAIL_SMTPD_CONCURRENCY_INCOMING=20

# Hide IP and hostname in Received header for authenticated senders (default:
# true)
COCOSMAIL_SMTPD_HIDE_RECEIVED_FROM_AUTH=true

# Check SPF of incoming mail and add a Received-SPF header (default: true)
COCOSMAIL_SMTPD_SPF_CHECK=true

# accept or reject for each SPF result, in order:
# none:neutral:pass:fail:softfail:permerror (default:
# accept:accept:accept:accept:accept:accept)
COCOSMAIL_SMTPD_SPF_ACTION=accept:accept:accept:accept:accept:accept

# Scan incoming mail with ClamAV (default: false)
COCOSMAIL_SMTPD_SCAN_CLAMAV_ENABLED=false

# clamd socket, or name:ip:port (default: /var/run/clamav/clamd.ctl)
COCOSMAIL_SMTPD_SCAN_CLAMAV_DSNS=/var/run/clamav/clamd.ctl

# --- deliverd ---

# Launch delivery of queued mail (default: false)
COCOSMAIL_DELIVERD_LAUNCH=true

# Local IPs for outgoing mail, & for failover or | for round robin (don't
# mix). 0.0.0.0 is any IPv4, :: any IPv6. Add :hostname for HELO, IPv6 in
# brackets: [2001:db8::1]:mail.example.com (default: 0.0.0.0&::)
COCOSMAIL_DELIVERD_LOCAL_IPS=0.0.0.0&::

# Maximum simultaneous local deliveries (default: 50)
COCOSMAIL_DELIVERD_CONCURRENCY_LOCAL=50

# Maximum simultaneous remote deliveries (default: 50)
COCOSMAIL_DELIVERD_CONCURRENCY_REMOTE=50

# Minutes a message stays in queue before it bounces (default: 10080)
COCOSMAIL_DELIVERD_QUEUE_LIFETIME=60400

# Minutes a bounce stays in queue before it's discarded (default: 10080)
COCOSMAIL_DELIVERD_QUEUE_BOUNCES_LIFETIME=10080

# Seconds to wait for a remote server reply (default: 300)
COCOSMAIL_DELIVERD_REMOTE_TIMEOUT=300

# Accept any certificate from remote servers, many have self-signed ones
# (default: false)
COCOSMAIL_DELIVERD_REMOTE_TLS_SKIPVERIFY=true

# Send in clear text if STARTTLS fails (default: false)
COCOSMAIL_DELIVERD_REMOTE_TLS_FALLBACK=true

# Send from the host that received the message, as configured in
# deliverd_local_ips or me (default: true)
COCOSMAIL_DELIVERD_REMOTE_USE_SAME_HOST=true

# DKIM sign outgoing mail (default: false)
COCOSMAIL_DELIVERD_DKIM_SIGN=false

# --- rfc ---

# Require HELO/EHLO before other commands (RFC 5321 4.1.1.1) (default: false)
COCOSMAIL_RFC_HELO_MANDATORY=false

# Require a resolvable hostname or an address in HELO (RFC 5321 2.3.5), many
# clients don't send one (default: false)
COCOSMAIL_RFC_HELO_NEED_FQN=false

# Reject MAIL FROM local part longer than 64 characters (RFC 5321 4.5.3.1.1)
# (default: false)
COCOSMAIL_RFC_MAILFROM_LOCALPART_SIZE=true

# --- users ---

# Directory of mailboxes (default: mailboxes)
COCOSMAIL_USERS_HOME_BASE=mailboxes

# Default mailbox quota, e.g. 1G, 100M, 100K
COCOSMAIL_USERS_MAILBOX_DEFAULT_QUOTA=200M

# Local delivery: maildir (built in) or dovecot (Dovecot LDA) (default:
# maildir)
COCOSMAIL_LDA_TYPE=maildir

# Path of dovecot-lda when lda_type is dovecot (default:
# /usr/lib/dovecot/dovecot-lda)
COCOSMAIL_DOVECOT_LDA=/usr/lib/dovecot/dovecot-lda

# --- pop3d ---

# Launch the POP3 server (default: false)
COCOSMAIL_POP3D_LAUNCH=true

# POP3 listeners, same format as smtpd_dsns. Must be ssl, nossl only on
# loopback. Certificate: ssl/pop3-CERT.crt and .key (required)
COCOSMAIL_POP3D_DSNS=0.0.0.0:1100:pop.cocosmail.io:ssl:pop.cocosmail.io

# Seconds before an idle POP3 client is disconnected (default: 300)
COCOSMAIL_POP3D_SERVER_TIMEOUT=300

# --- rest ---

# Launch the REST API server (default: false)
COCOSMAIL_REST_SERVER_LAUNCH=false

# REST server IP, IPv6 without brackets (default: 127.0.0.1)
COCOSMAIL_REST_SERVER_IP=127.0.0.1

# REST server port (default: 8080)
COCOSMAIL_REST_SERVER_PORT=8080

# Use HTTPS, certificate ssl/web_server.crt and .key (default: false)
COCOSMAIL_REST_SERVER_IS_TLS=false

# REST HTTP auth login
COCOSMAIL_REST_SERVER_LOGIN=login

# REST HTTP auth password
COCOSMAIL_REST_SERVER_PASSWD=passwd

# --- microservices ---

# URLs called on new SMTP connection, separated by ;
COCOSMAIL_MS_SMTPD_NEWCLIENT=

# URLs called after HELO/EHLO, separated by ;
COCOSMAIL_MS_SMTPD_HELO=

# URLs called after MAIL FROM, separated by ;
COCOSMAIL_MS_SMTPD_MAIL_FROM=

# URLs called after RCPT TO to check if relay is granted, separated by ;
COCOSMAIL_MS_SMTPD_RCPTTO=

# URLs called after DATA, separated by ;
COCOSMAIL_MS_SMTPD_DATA=

# URLs called before queueing, can change envelope, separated by ;
COCOSMAIL_MS_SMTPD_BEFORE_QUEUEING=

# URLs receiving smtpd telemetry, separated by ;
COCOSMAIL_MS_SMTPD_SEND_TELEMETRY=

# URLs returning remote routes for deliverd, separated by ;
COCOSMAIL_MS_DELIVERD_GET_ROUTES=

# URLs receiving deliverd telemetry, separated by ;
COCOSMAIL_MS_DELIVERD_SEND_TELEMETRY=

# --- openstack ---

# OpenStack object storage support (not available) (default: false)
COCOSMAIL_OPENSTACK_ENABLE=false
